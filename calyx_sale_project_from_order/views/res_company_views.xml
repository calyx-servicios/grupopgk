<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_calyx_sale_project" model="ir.ui.view">
        <field name="name">res.company.form.calyx.sale.project</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group" position="after">
                <group string="Proyectos Calyx" name="calyx_sale_project_group">
                    <field name="calyx_sale_project_from_order_enabled"/>
                    <div class="text-muted" colspan="2">
                        Genera un proyecto por OV y una tarea por cada línea de servicio al confirmar órdenes de venta directas.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
