<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!--
        Ajuste histórico puntual: cancela en lote las reclasificaciones que
        quedaron en Pending. Se expone únicamente como acción contextual de la
        vista lista y sólo para base.group_system, para que no se incorpore al
        flujo habitual una vez terminada la regularización.
    -->
    <record id="action_timesheet_reclassify_mass_cancel" model="ir.actions.server">
        <field name="name">Cancelar reclasificaciones pendientes (ajuste histórico)</field>
        <field name="model_id" ref="timesheet_reclassify_odoo.model_timesheet_reclassify"/>
        <field name="binding_model_id" ref="timesheet_reclassify_odoo.model_timesheet_reclassify"/>
        <field name="binding_view_types">list</field>
        <field name="binding_type">action</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_system')])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_mass_cancel()</field>
    </record>

</odoo>
