<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_hr_employee_timesheet_lines_restricted" model="ir.actions.act_window">
        <field name="name">Timesheets</field>
        <field name="res_model">account.analytic.line</field>
        <field name="search_view_id" ref="hr_timesheet.hr_timesheet_line_search"/>
        <field name="domain">[("project_id", "!=", False), ("employee_id", "=", active_id)]</field>
        <field name="context">{
            "search_default_month": 1,
            "search_default_employee_id": [active_id],
            "default_employee_id": active_id,
            "from_employee_form_timesheet": True
        }</field>
    </record>

    <record id="action_hr_employee_timesheet_lines_restricted_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="act_window_id" ref="action_hr_employee_timesheet_lines_restricted"/>
    </record>

    <record id="action_hr_employee_timesheet_lines_restricted_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_timesheet.hr_timesheet_line_form"/>
        <field name="act_window_id" ref="action_hr_employee_timesheet_lines_restricted"/>
    </record>

    <record id="hr_employee_view_form_inherit_timesheet_restrict" model="ir.ui.view">
        <field name="name">hr.employee.form.timesheet.restrict.lines</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_timesheet.hr_employee_view_form_inherit_timesheet"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(hr_timesheet.timesheet_action_from_employee)d']" position="attributes">
                <attribute name="name">%(hr_employee_timesheet_entry_restrict.action_hr_employee_timesheet_lines_restricted)d</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_hr_employee_timesheet_sheet_restricted" model="ir.actions.act_window">
        <field name="name">Timesheets</field>
        <field name="res_model">hr_timesheet.sheet</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="hr_timesheet_sheet.view_hr_timesheet_sheet_filter"/>
        <field name="domain">[("employee_id", "=", active_id)]</field>
        <field name="context">{
            "search_default_employee_id": [active_id],
            "default_employee_id": active_id,
            "from_employee_form_timesheet": True
        }</field>
    </record>

    <record id="hr_timesheet_sheet_employee_extd_form_restrict" model="ir.ui.view">
        <field name="name">hr.employee.form.timesheet.restrict</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_timesheet_sheet.hr_timesheet_sheet_employee_extd_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(hr_timesheet_sheet.act_hr_employee_2_hr_timesheet)d']" position="attributes">
                <attribute name="name">%(hr_employee_timesheet_entry_restrict.action_hr_employee_timesheet_sheet_restricted)d</attribute>
            </xpath>
        </field>
    </record>
</odoo>
