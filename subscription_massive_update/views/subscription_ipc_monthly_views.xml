<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subscription_ipc_monthly_tree" model="ir.ui.view">
        <field name="name">subscription.ipc.monthly.tree</field>
        <field name="model">subscription.ipc.monthly</field>
        <field name="arch" type="xml">
            <tree string="IPC Mensual" default_order="period_year desc, period_month desc">
                <field name="period"/>
                <field name="percentage"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_subscription_ipc_monthly_form" model="ir.ui.view">
        <field name="name">subscription.ipc.monthly.form</field>
        <field name="model">subscription.ipc.monthly</field>
        <field name="arch" type="xml">
            <form string="IPC Mensual">
                <sheet>
                    <group>
                        <field name="period" placeholder="01/2026"/>
                        <field name="percentage"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_subscription_ipc_monthly_search" model="ir.ui.view">
        <field name="name">subscription.ipc.monthly.search</field>
        <field name="model">subscription.ipc.monthly</field>
        <field name="arch" type="xml">
            <search string="Buscar IPC Mensual">
                <field name="period"/>
                <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_subscription_ipc_monthly" model="ir.actions.act_window">
        <field name="name">IPC Mensual</field>
        <field name="res_model">subscription.ipc.monthly</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_subscription_ipc_monthly_search"/>
        <field name="target">current</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay índices IPC registrados todavía.
            </p>
            <p>
                Cargue un valor mensual para usarlo luego en la
                actualización masiva de suscripciones.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_subscription_ipc_monthly"
        name="IPC Mensual"
        parent="account.menu_finance_configuration"
        action="action_subscription_ipc_monthly"
        sequence="120"
        groups="account.group_account_manager"
    />
</odoo>