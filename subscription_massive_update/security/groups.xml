<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_subscription_massive_update_category" model="ir.module.category">
        <field name="name">Subscription Tariff Control</field>
        <field name="description">Controls access to tariff updates, IPC, and reports.</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_subscription_contracts" model="res.groups">
        <field name="name">Contratos</field>
        <field name="category_id" ref="subscription_massive_update.module_subscription_massive_update_category"/>
        <field name="implied_ids" eval="[(4, ref('subscription_package.group_subscription_user'))]"/>
    </record>

    <record id="group_subscription_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="subscription_massive_update.module_subscription_massive_update_category"/>
        <field name="implied_ids" eval="[(4, ref('subscription_massive_update.group_subscription_contracts')), (4, ref('subscription_package.group_subscription_manager')), (4, ref('account.group_account_manager'))]"/>
    </record>

    <record id="group_subscription_partners" model="res.groups">
        <field name="name">Socios</field>
        <field name="category_id" ref="subscription_massive_update.module_subscription_massive_update_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('subscription_package.group_subscription_user'))]"/>
    </record>
</odoo>