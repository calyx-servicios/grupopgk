<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="tariff_ctrl_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="payload" t-value="report_data"/>
                <div class="page tariff-control-page">
                    <style>
                        .tariff-control-page {
                            padding-top: 0;
                        }
                        .tariff-control-content {
                            margin-top: 0;
                        }
                        .tariff-control-content h2 {
                            font-size: 20px;
                            margin-top: 0;
                            margin-bottom: 12px;
                        }
                        .tariff-control-table {
                            width: 100%;
                            table-layout: fixed;
                            font-size: 13px;
                            border-collapse: collapse;
                        }
                        .tariff-control-table th,
                        .tariff-control-table td {
                            padding: 4px 3px;
                            vertical-align: top;
                            overflow-wrap: anywhere;
                            word-wrap: break-word;
                            white-space: normal;
                        }
                        .tariff-control-table th {
                            font-size: 12px;
                            line-height: 1.2;
                        }
                        .tariff-control-filter {
                            width: 100%;
                            table-layout: fixed;
                            font-size: 13px;
                        }
                        .tariff-control-filter td {
                            padding: 4px;
                            overflow-wrap: anywhere;
                            word-wrap: break-word;
                            white-space: normal;
                        }
                    </style>
                    <div class="tariff-control-content">
                        <h2>Control de Actualizaciones de Tarifa</h2>
                        <table class="table table-sm table-bordered tariff-control-filter" style="margin-bottom: 12px;">
                            <tbody>
                                <tr>
                                    <td><strong>Compañías</strong></td>
                                    <td><span t-esc="payload.get('filters', {}).get('companies', '')"/></td>
                                    <td><strong>Estado</strong></td>
                                    <td><span t-esc="payload.get('filters', {}).get('state', '')"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Desde</strong></td>
                                    <td><span t-esc="payload.get('filters', {}).get('date_from', '')"/></td>
                                    <td><strong>Hasta</strong></td>
                                    <td><span t-esc="payload.get('filters', {}).get('date_to', '')"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Tipo actualización</strong></td>
                                    <td><span t-esc="payload.get('filters', {}).get('update_frequency', '')"/></td>
                                    <td><strong>Moneda</strong></td>
                                    <td><span t-esc="payload.get('filters', {}).get('currency_filter', '')"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Sección 1 - Suscripciones actualizadas en el período</h3>
                        <table class="table table-sm table-bordered tariff-control-table">
                            <colgroup>
                                <col style="width: 8%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 10%;"/>
                                <col style="width: 6%;"/>
                                <col style="width: 8%;"/>
                                <col style="width: 7%;"/>
                                <col style="width: 9%;"/>
                                <col style="width: 14%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 7%;"/>
                                <col style="width: 7%;"/>
                                <col style="width: 7%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 4%;"/>
                                <col style="width: 8%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Compañía</th>
                                    <th>SO</th>
                                    <th>SUS</th>
                                    <th>Tipo actualización</th>
                                    <th>Fecha cambio</th>
                                    <th>Usuario</th>
                                    <th>Producto</th>
                                    <th>Cuenta analítica</th>
                                    <th>Cant.</th>
                                    <th>P.U. anterior</th>
                                    <th>P.U. nuevo</th>
                                    <th>Subtotal neto</th>
                                    <th>% aplicado</th>
                                    <th>Moneda</th>
                                    <th>Comercial</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="payload.get('section_one_rows', [])" t-as="row">
                                    <tr>
                                        <td><span t-esc="row.get('company', '')"/></td>
                                        <td><span t-esc="row.get('so', '')"/></td>
                                        <td><span t-esc="row.get('sus', '')"/></td>
                                        <td><span t-esc="row.get('update_frequency', '')"/></td>
                                        <td><span t-esc="row.get('change_date', '')"/></td>
                                        <td><span t-esc="row.get('user', '')"/></td>
                                        <td><span t-esc="row.get('product', '')"/></td>
                                        <td><span t-esc="row.get('analytic_account', '')"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % row.get('qty', 0.0)"/></td>
                                        <td class="text-right"><span t-esc="row.get('old_price_display', '')"/></td>
                                        <td class="text-right"><span t-esc="row.get('new_price_display', '')"/></td>
                                        <td class="text-right"><span t-esc="row.get('subtotal_net_display', '')"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % row.get('applied_percentage', 0.0)"/></td>
                                        <td><span t-esc="row.get('currency', '')"/></td>
                                        <td><span t-esc="row.get('commercial', '')"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h4>Subtotal por cliente</h4>
                        <table class="table table-sm table-bordered tariff-control-table">
                            <colgroup>
                                <col style="width: 10%;"/>
                                <col style="width: 28%;"/>
                                <col style="width: 20%;"/>
                                <col style="width: 20%;"/>
                                <col style="width: 22%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>SO</th>
                                    <th>Cliente</th>
                                    <th>Total original neto</th>
                                    <th>Total actual neto</th>
                                    <th>Variación acumulada %</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="payload.get('partner_subtotals', [])" t-as="subtotal">
                                    <tr>
                                        <td><span t-esc="subtotal.get('so', '')"/></td>
                                        <td><span t-esc="subtotal.get('partner_name', '')"/></td>
                                        <td class="text-right"><span t-esc="subtotal.get('total_original_display', '')"/></td>
                                        <td class="text-right"><span t-esc="subtotal.get('total_current_display', '')"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % subtotal.get('variation', 0.0)"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <h3>Sección 2 - Suscripciones sin actualización en el período</h3>
                        <table class="table table-sm table-bordered tariff-control-table">
                            <colgroup>
                                <col style="width: 9%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 11%;"/>
                                <col style="width: 7%;"/>
                                <col style="width: 9%;"/>
                                <col style="width: 11%;"/>
                                <col style="width: 15%;"/>
                                <col style="width: 5%;"/>
                                <col style="width: 8%;"/>
                                <col style="width: 9%;"/>
                                <col style="width: 4%;"/>
                                <col style="width: 7%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Compañía</th>
                                    <th>SO</th>
                                    <th>SUS</th>
                                    <th>Tipo actualización</th>
                                    <th>Última actualización</th>
                                    <th>Producto</th>
                                    <th>Cuenta analítica</th>
                                    <th>Cant.</th>
                                    <th>P.U. actual</th>
                                    <th>Subtotal neto</th>
                                    <th>Moneda</th>
                                    <th>Comercial</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="payload.get('section_two_rows', [])" t-as="row">
                                    <tr>
                                        <td><span t-esc="row.get('company', '')"/></td>
                                        <td><span t-esc="row.get('so', '')"/></td>
                                        <td><span t-esc="row.get('sus', '')"/></td>
                                        <td><span t-esc="row.get('update_frequency', '')"/></td>
                                        <td><span t-esc="row.get('last_update', '')"/></td>
                                        <td><span t-esc="row.get('product', '')"/></td>
                                        <td><span t-esc="row.get('analytic_account', '')"/></td>
                                        <td class="text-right"><span t-esc="'%.2f' % row.get('qty', 0.0)"/></td>
                                        <td class="text-right"><span t-esc="row.get('current_price_display', '')"/></td>
                                        <td class="text-right"><span t-esc="row.get('subtotal_net_display', '')"/></td>
                                        <td><span t-esc="row.get('currency', '')"/></td>
                                        <td><span t-esc="row.get('commercial', '')"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="paperformat_subscription_tariff_control_landscape" model="report.paperformat">
        <field name="name">Subscription Tariff Control A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">50</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_subscription_tariff_control_pdf" model="ir.actions.report">
        <field name="name">Control de Actualizaciones de Tarifa (PDF)</field>
        <field name="model">subscription.tariff.update.control.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">subscription_massive_update.tariff_ctrl_pdf</field>
        <field name="report_file">subscription_massive_update.tariff_ctrl_pdf</field>
        <field name="paperformat_id" ref="paperformat_subscription_tariff_control_landscape"/>
        <field name="print_report_name">'Control_Actualizaciones_Tarifa_%s' % (object.date_to or '')</field>
    </record>

    <record id="action_report_subscription_tariff_control_xlsx" model="ir.actions.report">
        <field name="name">Control de Actualizaciones de Tarifa (XLSX)</field>
        <field name="model">subscription.tariff.update.control.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">subscription_massive_update.tariff_ctrl_xlsx</field>
        <field name="report_file">subscription_massive_update.tariff_ctrl_xlsx</field>
    </record>
</odoo>