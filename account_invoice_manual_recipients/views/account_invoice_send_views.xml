<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_invoice_send_wizard_form_manual_recipients"
            model="ir.ui.view">
        <field name="name">account.invoice.send.form.manual.recipients</field>
        <field name="model">account.invoice.send</field>
        <field name="inherit_id" ref="account.account_invoice_send_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='partner_ids']" position="replace">
                <label for="manual_recipient_emails" string="Destinatarios"
                       groups="base.group_user"/>
            </xpath>
            <xpath expr="//field[@name='partner_ids']/.." position="replace">
                <div groups="base.group_user">
                    <field name="manual_recipient_emails"
                           placeholder="correo1@dominio.com, correo2@dominio.com"
                           attrs="{'required': [('is_email', '=', True)]}">
                    </field>
                    <div class="text-muted"
                         attrs="{'invisible': [('is_email', '=', False)]}">
                        Ingresa uno o mas correos separados por coma o punto y coma.
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
