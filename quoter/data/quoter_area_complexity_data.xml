<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Configuración que depende de áreas creadas desde la UI (TAX, Auditoría): NO está en el
         manifest. La carga la post-migración 15.0.6.9.0 después de asignar xmlid a las áreas y
         de dejar en Auditoría los niveles de riesgo y las ramas-industria. -->

    <!-- Tabla #4: tamaño de empresa → complejidad (TAX) -->
    <record id="quoter_area_size_level_tax_micro" model="quoter.area.size.level">
        <field name="area_id" ref="quoter_area_tax"/>
        <field name="company_size">micro</field>
        <field name="complexity_level_id" ref="quoter_complexity_level_low"/>
    </record>
    <record id="quoter_area_size_level_tax_small" model="quoter.area.size.level">
        <field name="area_id" ref="quoter_area_tax"/>
        <field name="company_size">small</field>
        <field name="complexity_level_id" ref="quoter_complexity_level_low"/>
    </record>
    <record id="quoter_area_size_level_tax_medium" model="quoter.area.size.level">
        <field name="area_id" ref="quoter_area_tax"/>
        <field name="company_size">medium</field>
        <field name="complexity_level_id" ref="quoter_complexity_level_medium"/>
    </record>
    <record id="quoter_area_size_level_tax_large" model="quoter.area.size.level">
        <field name="area_id" ref="quoter_area_tax"/>
        <field name="company_size">large</field>
        <field name="complexity_level_id" ref="quoter_complexity_level_high"/>
    </record>

    <!-- Auditoría: tamaño de empresa → nivel de riesgo (configurable después desde
         Configuración → Riesgo por tamaño de empresa) -->
    <record id="quoter_area_size_level_auditoria_micro" model="quoter.area.size.level">
        <field name="area_id" ref="quoter_area_auditoria"/>
        <field name="company_size">micro</field>
        <field name="complexity_level_id" ref="quoter_complexity_level_audit_low"/>
    </record>
    <record id="quoter_area_size_level_auditoria_small" model="quoter.area.size.level">
        <field name="area_id" ref="quoter_area_auditoria"/>
        <field name="company_size">small</field>
        <field name="complexity_level_id" ref="quoter_complexity_level_audit_medium"/>
    </record>
    <record id="quoter_area_size_level_auditoria_medium" model="quoter.area.size.level">
        <field name="area_id" ref="quoter_area_auditoria"/>
        <field name="company_size">medium</field>
        <field name="complexity_level_id" ref="quoter_complexity_level_audit_high"/>
    </record>
    <record id="quoter_area_size_level_auditoria_large" model="quoter.area.size.level">
        <field name="area_id" ref="quoter_area_auditoria"/>
        <field name="company_size">large</field>
        <field name="complexity_level_id" ref="quoter_complexity_level_audit_very_high"/>
    </record>

    <!-- Los 3 productos de Auditoría. Al crearse, la línea de servicio genera el producto y una
         fila de horas por nivel × rama; las horas AE (Tabla #3) las carga la post-migración. -->
    <record id="quoter_service_line_audit_audit" model="quoter.service.line">
        <field name="area_id" ref="quoter_area_auditoria"/>
        <field name="name">Auditoría</field>
        <field name="sequence">1</field>
        <field name="separator_tag_id" ref="quoter_line_separator_tag_default"/>
    </record>
    <record id="quoter_service_line_audit_balance" model="quoter.service.line">
        <field name="area_id" ref="quoter_area_auditoria"/>
        <field name="name">Armado de balance en Excel y Word</field>
        <field name="sequence">2</field>
        <field name="separator_tag_id" ref="quoter_line_separator_tag_additional"/>
    </record>
    <record id="quoter_service_line_audit_axi" model="quoter.service.line">
        <field name="area_id" ref="quoter_area_auditoria"/>
        <field name="name">Cálculo de AXI contable</field>
        <field name="sequence">3</field>
        <field name="separator_tag_id" ref="quoter_line_separator_tag_additional"/>
    </record>
</odoo>
