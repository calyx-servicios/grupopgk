<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_quoter_admin" model="res.groups">
            <field name="name">Quoter - Administrador</field>
            <field name="category_id" ref="base.module_category_sales_management"/>
            <field name="implied_ids" eval="[(4, ref('quoter.group_quoter_access')), (4, ref('sales_team.group_sale_manager'))]"/>
            <field name="comment">Configuración avanzada del cotizador: tarifas, categorías de recursos y administración.</field>
        </record>
    </data>

    <!-- Tarifas (lista de precios): gestión desde Cotizador solo administrador del cotizador. -->
    <record id="quoter_pricelist_admin_access_rule" model="ir.rule">
        <field name="name">Quoter: administrador acceso completo a tarifas</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('quoter.group_quoter_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="access_product_pricelist_quoter_admin" model="ir.model.access">
        <field name="name">product.pricelist.quoter.admin</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="group_id" ref="quoter.group_quoter_admin"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="access_product_pricelist_item_quoter_admin" model="ir.model.access">
        <field name="name">product.pricelist.item.quoter.admin</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="group_id" ref="quoter.group_quoter_admin"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
