<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Inherit Sale Order Form View -->
    <record id="view_order_form_quoter_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.quoter.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            
            <!-- Presupuesto estándar oculto en cotización; título = número COT -->
            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="before">
                <field name="quoter_form_title" readonly="1" nolabel="1"
                       class="text-break"
                       attrs="{'invisible': [('is_quotation', '=', False)]}"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>
            
            <!-- Add is_quotation field in header -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="quoter_menu_context" invisible="1"/>
                <field name="is_quotation" invisible="1"/>
                <field name="quotation_sequence" attrs="{'invisible': [('is_quotation', '=', False)]}"/>
            </xpath>
            <!-- res_users_partner_fields: oculto en cotización; sin obligatorio (required=1 del padre). -->
            <xpath expr="//field[@name='partner']" position="replace">
                <field name="partner"
                       options="{'no_create': True, 'no_open': True}"
                       attrs="{'invisible': [('is_quotation', '=', True)], 'required': [('is_quotation', '=', False)]}"/>
            </xpath>
            
            <!-- Cotización: gerente y socio editables por cualquier usuario; lista por grupo. -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="quoter_manager_id"
                       attrs="{'invisible': [('is_quotation', '=', False)]}"
                       domain="[('share', '=', False), ('active', '=', True), ('groups_id', 'in', [%(quoter.group_quoter_manager)d])]"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="quoter_partner_id"
                       attrs="{'invisible': [('is_quotation', '=', False)]}"
                       domain="[('share', '=', False), ('active', '=', True), ('groups_id', 'in', [%(quoter.group_quoter_partner)d])]"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="quoter_area_ids"
                       attrs="{'invisible': [('is_quotation', '=', False)]}"
                       widget="many2many_tags"
                       options="{'no_create': True}"/>
                <field name="date_order"
                       string="Fecha de cotización"
                       widget="datetime"
                       attrs="{'invisible': [('is_quotation', '=', False)], 'readonly': [('state', 'in', ('done', 'cancel'))]}"/>
                <!-- Plazo de pago (editable) → calcula Expiración en servidor -->
                <field name="payment_term_id"
                       string="Plazo de pago"
                       options="{'no_create': True}"
                       attrs="{'invisible': [('is_quotation', '=', False)], 'required': [('is_quotation', '=', True)]}"/>
                <field name="validity_date"
                       string="Expiración"
                       force_save="1"
                       attrs="{'invisible': [('is_quotation', '=', False)], 'readonly': [('is_quotation', '=', True)]}"/>
            </xpath>

            <!-- Ocultar solo la fecha del encabezado derecho (order_details), no la de cabecera cotizador. -->
            <xpath expr="//group[@name='order_details']//label[@for='date_order']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']//field[@name='date_order']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='date_of_issue']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>
            <!-- validity_date del formulario estándar: oculto; se usa el de cabecera cotizador -->
            <xpath expr="//group[@name='order_details']//field[@name='validity_date']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>

            <!-- report_custom: no aplica en cotizaciones profesionales -->
            <xpath expr="//field[@name='sales_order_with_detail']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//button[@name='print_quotation'][hasclass('o_sale_print')]" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('is_quotation', '=', True), ('sales_order_with_detail', '!=', 'with_detail')]}</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>

            <!-- Campos de cabecera ocultos para cotizador -->
            <xpath expr="//field[@name='pricelist_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='order_details']//field[@name='payment_term_id']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//label[@for='pricelist_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='pricelist_id']/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Pestaña estándar convertida en resumen para cotizaciones -->
            <xpath expr="//page[@name='order_lines']" position="attributes">
                <attribute name="string">Resumen general</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']//field[@name='order_line']" position="attributes">
                <attribute name="attrs">{'readonly': [('state', 'in', ('done','cancel'))], 'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']//group[@name='note_group']/group[1]" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='optional_products']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('is_quotation', '=', True), ('state', 'not in', ['draft', 'sent'])]}</attribute>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='customer_signature']" position="attributes">
                <attribute name="attrs">{'invisible': [('is_quotation', '=', True)]}</attribute>
            </xpath>

            <!-- Cotizador: estrategia + cotización por bloques (quoter.sale.order.area). -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Información estratégica" name="quoter_strategy"
                      attrs="{'invisible': [('is_quotation', '=', False)]}">
                    <group>
                        <field name="quoter_q_competitors"
                               attrs="{'required': [('is_quotation', '=', True)]}"/>
                        <field name="quoter_q_budget"
                               attrs="{'required': [('is_quotation', '=', True)]}"/>
                        <field name="quoter_q_current_payment"
                               attrs="{'required': [('is_quotation', '=', True)]}"/>
                        <field name="quoter_q_notes"
                               attrs="{'required': [('is_quotation', '=', True)]}"/>
                    </group>
                </page>
                <page string="Cotización por área" name="quoter_area"
                      class="o_quoter_area_tab_pane"
                      attrs="{'invisible': [('is_quotation', '=', False)]}">
                    <field name="quoter_primary_tab_area_name" invisible="1"/>
                    <field name="quoter_area_block_count" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         attrs="{'invisible': [('quoter_area_block_ids', '!=', False)]}">
                        Elija al menos un área profesional en la cabecera del presupuesto para habilitar los bloques de cotización.
                    </div>
                    <div class="o_quoter_area_blocks_embed position-relative">
                    <field name="quoter_area_block_ids"
                           mode="tree,form"
                           context="{'default_order_id': active_id}">
                        <tree string="Bloques" create="0" delete="0" class="o_quoter_area_o2m_tree_hidden">
                            <field name="sequence" invisible="1"/>
                            <field name="area_id" readonly="1" options="{'no_open': True}"/>
                        </tree>
                        <form string="Bloque de cotización por área">
                            <header>
                                <button name="action_quoter_publish"
                                        string="Cerrar"
                                        type="object"
                                        class="btn-primary"
                                        attrs="{'invisible': ['|', ('block_editable', '=', False), ('state', '!=', 'draft')]}"/>
                                <button name="action_quoter_cancel_block"
                                        string="Cancelar bloque"
                                        type="object"
                                        class="btn-secondary"
                                        icon="fa-times"
                                        attrs="{'invisible': ['|', ('block_editable', '=', False), ('state', '!=', 'draft')]}"/>
                                <button name="action_quoter_reopen"
                                        string="Reabrir"
                                        type="object"
                                        class="btn-secondary"
                                        icon="fa-undo"
                                        attrs="{'invisible': [('state', '!=', 'published')]}"/>
                                <button name="action_quoter_load_default_products"
                                        string="Cargar predeterminados"
                                        type="object"
                                        class="btn-secondary"
                                        attrs="{'invisible': ['|', ('block_editable', '=', False), ('state', 'not in', (False, 'draft'))]}"/>
                                <field name="state" widget="statusbar"
                                       statusbar_visible="draft,published,cancel"
                                       attrs="{'readonly': [('block_editable', '=', False)]}"/>
                            </header>
                            <sheet>
                                <field name="block_editable" invisible="1"/>
                                <field name="structure_locked" invisible="1"/>
                                <field name="lines_frozen" invisible="1"/>
                                <field name="complexity_level_frozen" invisible="1"/>
                                <field name="complexity_level_custom_label" invisible="1"/>
                                <field name="area_allow_change_complexity_level" invisible="1"/>
                                <field name="complexity_level_change_allowed" invisible="1"/>
                                <field name="area_use_branching" invisible="1"/>
                                <field name="area_is_tax" invisible="1"/>
                                <field name="order_id" invisible="1"/>
                                <field name="area_branch_ids" invisible="1"/>
                                <field name="selectable_product_ids" invisible="1"/>
                                <field name="quoter_user_is_assigned_manager" invisible="1"/>
                                <field name="quoter_user_is_assigned_partner" invisible="1"/>
                                <group string="Cotización por área">
                                    <group>
                                        <field name="area_id" readonly="1" options="{'no_open': True}"/>
                                        <field name="complexity_level_id"
                                               class="o_quoter_block_complexity_level"
                                               string="Nivel de complejidad"
                                               options="{'no_create': True, 'no_open': True}"
                                               attrs="{'invisible': [('area_is_tax', '=', False)], 'readonly': [('complexity_level_change_allowed', '=', False)]}"/>
                                        <field name="complexity_level_id"
                                               class="o_quoter_block_complexity_level"
                                               string="Nivel del área"
                                               options="{'no_create': True, 'no_open': True}"
                                               attrs="{'invisible': [('area_is_tax', '=', True)], 'readonly': [('complexity_level_change_allowed', '=', False)]}"/>
                                        <field name="branch_id"
                                               string="Rama"
                                               options="{'no_create': True}"
                                               domain="[('id', 'in', area_branch_ids)]"
                                               attrs="{'readonly': [('block_editable', '=', False)], 'invisible': ['|', ('area_use_branching', '=', False), ('complexity_level_id', '=', False)]}"/>
                                        <field name="global_discount_amount"
                                               string="Descuento %"
                                               attrs="{'readonly': ['|', ('block_editable', '=', False), ('quoter_user_is_assigned_partner', '=', False)], 'invisible': [('complexity_level_id', '=', False)]}"/>
                                        <field name="global_surcharge_amount"
                                               string="Recargo %"
                                               attrs="{'readonly': ['|', ('block_editable', '=', False), ('quoter_user_is_assigned_partner', '=', False)], 'invisible': [('complexity_level_id', '=', False)]}"/>
                                    </group>
                                </group>
                                <div class="alert alert-info" role="alert"
                                     attrs="{'invisible': ['|', ('complexity_level_id', '!=', False), ('area_is_tax', '=', True)]}">
                                    Seleccione el nivel del área y guarde el bloque para habilitar productos y líneas.
                                </div>
                                <div class="alert alert-info" role="alert"
                                     attrs="{'invisible': ['|', ('complexity_level_id', '!=', False), ('area_is_tax', '=', False)]}">
                                    Seleccione el nivel de complejidad y guarde el bloque para habilitar productos y líneas.
                                </div>
                                <field name="order_line_ids"
                                       context="{'default_quoter_tab_area_id': area_id, 'default_quoter_block_id': id, 'default_order_id': order_id}"
                                       attrs="{'invisible': [('complexity_level_id', '=', False)], 'readonly': [('lines_frozen', '=', True)]}">
                                    <tree editable="bottom" decoration-bf="display_type == 'line_section'">
                                        <field name="company_id" invisible="1"/>
                                        <field name="display_type" invisible="1"/>
                                        <field name="order_id" invisible="1"/>
                                        <field name="quoter_tab_area_id" invisible="1"/>
                                        <field name="quoter_block_id" invisible="1"/>
                                        <field name="quoter_separator_section_tag_id" invisible="1"/>
                                        <field name="quoter_separator_style_mode" invisible="1"/>
                                        <field name="quoter_separator_color" invisible="1"/>
                                        <field name="quoter_product_separator_tag_color" invisible="1"/>
                                        <field name="quoter_area_separator_visual_mode" invisible="1"/>
                                        <field name="quoter_manual_load" invisible="1"/>
                                        <field name="quoter_can_edit_range_hours" invisible="1"/>
                                        <field name="quoter_can_edit_total_hours" invisible="1"/>
                                        <field name="quoter_is_adjustment_line" invisible="1"/>
                                        <field name="quoter_adjustment_parent_line_id" invisible="1"/>
                                        <field name="quoter_has_adjustment_line" invisible="1"/>
                                        <button name="action_quoter_add_adjustment_line"
                                                type="object"
                                                icon="fa-wrench"
                                                string="Ajustar"
                                                groups="quoter.group_quoter_manager"
                                                attrs="{'invisible': ['|', '|', '|', '|', ('display_type', '!=', False), ('quoter_is_adjustment_line', '=', True), ('quoter_has_adjustment_line', '=', True), ('parent.lines_frozen', '=', True), ('parent.quoter_user_is_assigned_manager', '=', False)]}"/>
                                        <field name="quoter_adjustment_status"
                                               readonly="1"
                                               groups="quoter.group_quoter_manager"
                                               attrs="{'invisible': ['|', '|', ('display_type', '!=', False), ('quoter_is_adjustment_line', '=', True), ('quoter_has_adjustment_line', '=', False)]}"/>
                                        <field name="product_id"
                                               options="{'no_create': True}"
                                               context="{'quoter_product_picker': 1, 'quoter_area_id': parent.area_id, 'quoter_order_id': parent.order_id, 'quoter_exclude_line_id': id}"
                                               attrs="{'readonly': [('parent.structure_locked', '=', True)], 'invisible': [('display_type', '!=', False)]}"/>
                                        <field name="name"
                                               attrs="{'readonly': ['|', ('parent.lines_frozen', '=', True), ('display_type', '!=', False)]}"/>
                                        <field name="product_uom_qty" invisible="1"/>
                                        <field name="price_unit" invisible="1" force_save="1"/>
                                        <field name="quoter_range_1_hours" optional="show" force_save="1"
                                               attrs="{'invisible': [('display_type', '!=', False)], 'readonly': ['|', ('parent.lines_frozen', '=', True), ('quoter_can_edit_range_hours', '=', False)]}"/>
                                        <field name="quoter_range_2_hours" optional="show" force_save="1"
                                               attrs="{'invisible': [('display_type', '!=', False)], 'readonly': ['|', ('parent.lines_frozen', '=', True), ('quoter_can_edit_range_hours', '=', False)]}"/>
                                        <field name="quoter_range_3_hours" optional="show" force_save="1"
                                               attrs="{'invisible': [('display_type', '!=', False)], 'readonly': ['|', ('parent.lines_frozen', '=', True), ('quoter_can_edit_range_hours', '=', False)]}"/>
                                        <field name="quoter_range_4_hours" optional="show" force_save="1"
                                               attrs="{'invisible': [('display_type', '!=', False)], 'readonly': ['|', ('parent.lines_frozen', '=', True), ('quoter_can_edit_range_hours', '=', False)]}"/>
                                        <field name="quoter_total_hours" string="Total horas" force_save="1"
                                               attrs="{'invisible': [('display_type', '!=', False)], 'readonly': ['|', ('parent.lines_frozen', '=', True), ('quoter_can_edit_total_hours', '=', False)]}"/>
                                        <field name="tax_id" widget="many2many_tags"
                                               attrs="{'invisible': [('display_type', '!=', False)], 'readonly': [('parent.lines_frozen', '=', True)]}"
                                               optional="show"/>
                                        <field name="quoter_adjustment_note"
                                               optional="show"
                                               placeholder="Completar justificación del ajuste..."
                                               groups="quoter.group_quoter_manager"
                                               attrs="{'invisible': [('display_type', '!=', False)], 'readonly': ['|', ('parent.lines_frozen', '=', True), ('quoter_is_adjustment_line', '=', False)], 'required': [('quoter_is_adjustment_line', '=', True)]}"/>
                                        <field name="price_subtotal" readonly="1"
                                               attrs="{'invisible': [('display_type', '!=', False)]}"/>
                                    </tree>
                                </field>
                                <div class="o_quoter_resumen_rango"
                                     attrs="{'invisible': [('complexity_level_id', '=', False)]}">
                                    <div class="o_quoter_resumen_rango_title">Resumen por rango</div>
                                    <field name="area_summary_html" nolabel="1" readonly="1"/>
                                </div>
                                <group class="oe_subtotal_footer oe_right o_quoter_area_footer_totals" colspan="2"
                                       attrs="{'invisible': [('complexity_level_id', '=', False)]}">
                                    <field name="caption_products" readonly="1" nolabel="1"/>
                                    <field name="product_untaxed" widget="monetary" readonly="1" nolabel="1"/>
                                    <newline/>
                                    <field name="caption_adjustments" readonly="1" nolabel="1"
                                           attrs="{'invisible': [('adjustment_untaxed', '=', 0)]}"/>
                                    <field name="adjustment_untaxed" widget="monetary" readonly="1" nolabel="1"
                                           attrs="{'invisible': [('adjustment_untaxed', '=', 0)]}"/>
                                    <newline/>
                                    <field name="caption_discount" readonly="1" nolabel="1"
                                           attrs="{'invisible': [('discount_line_amount', '=', 0)]}"/>
                                    <field name="discount_line_amount" nolabel="1" widget="monetary" readonly="1"
                                           attrs="{'invisible': [('discount_line_amount', '=', 0)]}"/>
                                    <newline/>
                                    <field name="caption_surcharge" readonly="1" nolabel="1"
                                           attrs="{'invisible': [('surcharge_line_amount', '=', 0)]}"/>
                                    <field name="surcharge_line_amount" nolabel="1" widget="monetary" readonly="1"
                                           attrs="{'invisible': [('surcharge_line_amount', '=', 0)]}"/>
                                    <newline/>
                                    <field name="caption_total" readonly="1" nolabel="1"/>
                                    <field name="total_untaxed" nolabel="1" widget="monetary" readonly="1"
                                           class="oe_subtotal_footer_separator"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                        <div class="o_quoter_area_block_form_slot border rounded bg-white">
                            <div class="o_quoter_area_block_form_body"></div>
                        </div>
                    </div>
                </page>
            </xpath>
            
        </field>
    </record>
    
    <!-- Inherit Sale Order Tree View (listas de presupuestos) -->
    <record id="view_quotation_tree_quoter" model="ir.ui.view">
        <field name="name">sale.order.tree.quoter</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="quoter_menu_context" invisible="1"/>
                <field name="quotation_sequence" optional="show"/>
                <field name="is_quotation" invisible="1"/>
                <field name="date_order" string="Fecha de cotización" optional="show"/>
                <field name="quoter_area_ids" widget="many2many_tags" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_quoter" model="ir.ui.view">
        <field name="name">sale.order.search.quoter</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="quoter_primary_area_id" string="Área"/>
                <field name="quoter_primary_complexity_level_id" string="Complejidad"/>
                <filter name="quoter_group_area"
                        string="Área"
                        context="{'group_by': 'quoter_primary_area_id'}"/>
                <filter name="quoter_group_complexity"
                        string="Complejidad"
                        context="{'group_by': 'quoter_primary_complexity_level_id'}"/>
            </xpath>
        </field>
    </record>
    
    <!-- Pedidos / presupuestos estándar: sin cotizaciones profesionales (is_quotation) -->
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="domain" eval="[('state', 'not in', ('draft', 'sent', 'cancel')), ('is_quotation', '=', False)]"/>
    </record>
    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="domain">[('is_quotation', '=', False)]</field>
    </record>
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="domain">[('is_quotation', '=', False)]</field>
    </record>
    <record id="sale.action_orders_to_invoice" model="ir.actions.act_window">
        <field name="domain">[('invoice_status', '=', 'to invoice'), ('is_quotation', '=', False)]</field>
    </record>
    <record id="sale.action_orders_upselling" model="ir.actions.act_window">
        <field name="domain">[('invoice_status', '=', 'upselling'), ('is_quotation', '=', False)]</field>
    </record>

</odoo>
