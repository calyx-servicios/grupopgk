<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_quoter_res_config_settings" model="ir.actions.act_window">
        <field name="name">Ajustes Cotizador</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'quoter'}</field>
    </record>

    <!-- Action for Quotations (Cliente > Cotizador) -->
    <record id="action_quotations_quoter" model="ir.actions.act_window">
        <field name="name">Cotizaciones</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
        <field name="context">{
            'default_is_quotation': True,
            'quoter_use_cot_sequence': True,
        }</field>
        <field name="domain">[('is_quotation', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva cotización profesional
            </p>
            <p>
                Las cotizaciones profesionales permiten configurar servicios por área,
                categoría de producto y nivel en cada bloque del cotizador.
            </p>
        </field>
    </record>

    <record id="action_quoter_pricelists" model="ir.actions.act_window">
        <field name="name">Tarifas</field>
        <field name="res_model">product.pricelist</field>
        <field name="view_mode">tree,form</field>
        <!-- Sobreescribe dominios viejos en BD que usaban is_quoter_pricelist (campo eliminado). -->
        <field name="domain">[]</field>
    </record>

    <!-- Odoo 15: icono en Home Menu solo si este menú raíz tiene action (no en un hijo). -->
    <record id="menu_quoter_root" model="ir.ui.menu">
        <field name="name">Cotizador</field>
        <field name="sequence">15</field>
        <field name="action" ref="action_quotations_quoter"/>
        <field name="web_icon">quoter,static/description/icon1.png</field>
        <field name="groups_id" eval="[(5, 0, 0)]"/>
    </record>

    <menuitem id="menu_quoter_products_root"
              name="Productos"
              parent="menu_quoter_root"
              sequence="20"/>

    <menuitem id="menu_quoter_products_templates"
              name="Productos"
              parent="menu_quoter_products_root"
              action="action_quoter_products_templates"
              sequence="1"/>

    <menuitem id="menu_quoter_products_variants"
              name="Variantes"
              parent="menu_quoter_products_root"
              action="action_quoter_products_variants"
              sequence="2"/>

    <menuitem id="menu_quoter_generic_products"
              name="Productos genéricos"
              parent="menu_quoter_products_root"
              action="action_quoter_generic_products_templates"
              sequence="3"/>

    <menuitem id="menu_quoter_create_generic_product"
              name="Crear producto genérico"
              parent="menu_quoter_products_root"
              action="action_quoter_generic_product_wizard"
              sequence="4"
              groups="quoter.group_quoter_manager,quoter.group_quoter_admin"/>

    <menuitem id="menu_quoter_products_pricing"
              name="Tarifa"
              parent="menu_quoter_products_root"
              action="action_quoter_pricelists"
              sequence="5"
              groups="quoter.group_quoter_admin"/>

    <!-- Configuración maestra: no visible para grupos por área (TAX, BPO, etc.). -->
    <menuitem id="menu_quoter_configuration"
              name="Configuración"
              parent="menu_quoter_root"
              groups="base.group_system,quoter.group_quoter_admin,quoter.group_quoter_manager"
              sequence="100"/>

    <record id="action_quoter_security_groups" model="ir.actions.act_window">
        <field name="name">Ajustes de grupos</field>
        <field name="res_model">res.groups</field>
        <field name="view_mode">tree,form</field>
        <field name="domain" eval="[('id', 'in', [ref('quoter.group_quoter_admin'), ref('quoter.group_quoter_manager'), ref('quoter.group_quoter_partner'), ref('quoter.group_quoter_tax'), ref('quoter.group_quoter_auditoria'), ref('quoter.group_quoter_bpo'), ref('quoter.group_quoter_payroll')])]"/>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_quoter_settings"
              name="Ajustes"
              parent="menu_quoter_configuration"
              action="action_quoter_res_config_settings"
              sequence="1"
              groups="base.group_system"/>

    <menuitem id="menu_quoter_professional_area"
              name="Áreas profesionales"
              parent="menu_quoter_configuration"
              action="action_quoter_professional_area"
              sequence="5"/>

    <menuitem id="menu_quoter_area_complexity_range"
              name="Categorías de recursos"
              parent="menu_quoter_configuration"
              action="action_quoter_area_complexity_range"
              sequence="6"
              groups="quoter.group_quoter_admin"/>

    <menuitem id="menu_quoter_line_separator_tag"
              name="Secciones de cotizador"
              parent="menu_quoter_configuration"
              action="action_quoter_line_separator_tag"
              sequence="8"/>

    <menuitem id="menu_quoter_complexity_level"
              name="Niveles de complejidad"
              parent="menu_quoter_configuration"
              action="action_quoter_complexity_level"
              sequence="9"/>

    <!-- Acceso explícito a ramas (tree/form) -->
    <record id="action_quoter_area_branch_menu" model="ir.actions.act_window">
        <field name="name">Ramas</field>
        <field name="res_model">quoter.area.branch</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_quoter_area_branch_tree"/>
    </record>

    <menuitem id="menu_quoter_area_branch"
              name="Ramas"
              parent="menu_quoter_configuration"
              action="action_quoter_area_branch_menu"
              sequence="10"/>

    <menuitem id="menu_quoter_service_line"
              name="Líneas de servicio"
              parent="menu_quoter_configuration"
              action="action_quoter_service_line"
              sequence="25"/>

</odoo>
