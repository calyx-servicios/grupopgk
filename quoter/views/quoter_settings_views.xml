<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_quoter" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.quoter</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Cotizador" string="Cotizador" data-key="quoter">
                    <h2>Cotizador</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Ajustes de grupos</span>
                                <div class="text-muted">
                                    Gestionar grupos Gerente, Socio y grupos por área (TAX, Auditoría, BPO, Payroll).
                                </div>
                                <div class="mt8">
                                    <button type="action"
                                            class="btn btn-link"
                                            name="%(quoter.action_quoter_security_groups)d"
                                            string="Abrir grupos de Cotizador"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Valores por defecto de cotización</span>
                                <div class="text-muted">
                                    Se aplican al crear una cotización desde el menú Cotizador.
                                </div>
                                <div class="content-group mt16">
                                    <div class="mt8">
                                        <span class="o_form_label">Plazo de pago por defecto (cotizador)</span>
                                        <field name="quoter_default_payment_term_id" options="{'no_create': True}"/>
                                    </div>
                                    <div class="mt8">
                                        <span class="o_form_label">Equipo de ventas por defecto (cotizador)</span>
                                        <field name="quoter_default_team_id" options="{'no_create': True}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

