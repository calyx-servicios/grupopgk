<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_hours_request_wizard_form" model="ir.ui.view">
        <field name="name">project.task.hours.request.wizard.form</field>
        <field name="model">project.task.hours.request.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="task_id" readonly="1"/>
                    <field name="segment"/>
                    <field name="current_hours_cap"/>
                    <field name="requested_hours"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Enviar solicitud" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
