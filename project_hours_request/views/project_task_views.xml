<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_form2_hours_request" model="ir.ui.view">
        <field name="name">project.task.form.hours.request</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button string="Solicitar horas adicionales" name="action_open_hours_request_wizard" type="object"
                    attrs="{'invisible': [('task_type', '!=', 'development')]}"/>
            </header>
            <div name="button_box" position="inside">
                <button name="action_view_hours_requests" type="object" class="oe_stat_button" icon="fa-clock-o"
                    attrs="{'invisible': [('task_type', '!=', 'development')]}">
                    <field name="hours_request_count" string="Horas adicionales" widget="statinfo"/>
                </button>
            </div>
            <field name="parent_id" position="after">
                <field name="can_edit_estimated_hours" invisible="1"/>
                <field name="estimated_dev_hours"
                    attrs="{'invisible': [('task_type', '!=', 'development')], 'readonly': [('can_edit_estimated_hours', '=', False)]}"/>
                <field name="estimated_deploy_hours"
                    attrs="{'invisible': [('task_type', '!=', 'development')], 'readonly': [('can_edit_estimated_hours', '=', False)]}"/>
                <field name="estimated_functional_test_hours"
                    attrs="{'invisible': [('task_type', '!=', 'development')], 'readonly': [('can_edit_estimated_hours', '=', False)]}"/>
                <field name="margin_hours"
                    attrs="{'invisible': [('task_type', '!=', 'development')], 'readonly': [('can_edit_estimated_hours', '=', False)]}"/>
                <field name="hours_cap" attrs="{'invisible': [('parent_id', '!=', False)]}"/>
            </field>
        </field>
    </record>

</odoo>
