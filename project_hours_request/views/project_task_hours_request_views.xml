<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_hours_request_form" model="ir.ui.view">
        <field name="name">project.task.hours.request.form</field>
        <field name="model">project.task.hours.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="can_approve" invisible="1"/>
                    <field name="can_cancel" invisible="1"/>
                    <button string="Aprobar" name="action_approve" type="object" class="oe_highlight"
                        attrs="{'invisible': [('can_approve', '=', False)]}"/>
                    <button string="Rechazar" name="action_reject" type="object"
                        attrs="{'invisible': [('can_approve', '=', False)]}"/>
                    <button string="Cancelar" name="action_cancel" type="object"
                        attrs="{'invisible': [('can_cancel', '=', False)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="segment"/>
                            <field name="margin_authorization" invisible="1"/>
                            <field name="previous_hours_cap" readonly="1"/>
                            <field name="requested_hours"/>
                            <field name="new_hours_cap" readonly="1"/>
                        </group>
                        <group>
                            <field name="requested_by" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approval_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="project_task_hours_request_tree" model="ir.ui.view">
        <field name="name">project.task.hours.request.tree</field>
        <field name="model">project.task.hours.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="segment"/>
                <field name="requested_hours"/>
                <field name="new_hours_cap"/>
                <field name="state"/>
                <field name="requested_by"/>
                <field name="approved_by"/>
                <field name="request_date"/>
            </tree>
        </field>
    </record>

    <record id="view_project_task_hours_request_action" model="ir.actions.act_window">
        <field name="name">Solicitudes de horas adicionales</field>
        <field name="res_model">project.task.hours.request</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        action="view_project_task_hours_request_action"
        id="menu_project_task_hours_request"
        parent="project.menu_projects_group_stage"
        sequence="6"
    />

</odoo>
