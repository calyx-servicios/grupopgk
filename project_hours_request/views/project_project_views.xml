<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_form_hours_requests" model="ir.ui.view">
        <field name="name">project.project.form.hours.requests</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <page name="settings" position="after">
                <page name="hours_requests" string="Horas adicionales">
                    <field name="hours_request_ids" readonly="1">
                        <tree>
                            <field name="task_id"/>
                            <field name="segment"/>
                            <field name="requested_hours"/>
                            <field name="reason"/>
                            <field name="state"/>
                            <field name="requested_by"/>
                            <field name="approved_by"/>
                            <field name="request_date"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>