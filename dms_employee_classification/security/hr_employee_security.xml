<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_own_record_rule" model="ir.rule">
        <field name="name">Empleado: ve solo su propia ficha</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="hr_employee_manager_full_access_rule" model="ir.rule">
        <field name="name">Administrator: ve todas las fichas</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
