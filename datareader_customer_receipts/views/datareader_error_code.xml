<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_datareader_error_code_tree" model="ir.ui.view">
        <field name="name">datareader.error.code.tree</field>
        <field name="model">datareader.error.code</field>
        <field name="arch" type="xml">
            <tree string="Códigos de error de DataReader" default_order="code asc">
                <field name="code"/>
                <field name="description"/>
                <field name="requires_review"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_datareader_error_code_form" model="ir.ui.view">
        <field name="name">datareader.error.code.form</field>
        <field name="model">datareader.error.code</field>
        <field name="arch" type="xml">
            <form string="Códigos de error de DataReader">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="description"/>
                        <field name="requires_review"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_datareader_error_code" model="ir.actions.act_window">
        <field name="name">Códigos de error de DataReader</field>
        <field name="res_model">datareader.error.code</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="groups_id" eval="[(4, ref('datareader_customer_receipts.group_datareader_admin'))]"/>
    </record>

    <menuitem
        id="menu_datareader_error_code"
        name="Códigos de error de DataReader"
        parent="account.menu_finance_configuration"
        action="action_datareader_error_code"
        sequence="110"
        groups="datareader_customer_receipts.group_datareader_admin"
    />
</odoo>
