<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_group_form_datareader" model="ir.ui.view">
        <field name="name">account.payment.group.form.datareader</field>
        <field name="model">account.payment.group</field>
        <field name="inherit_id" ref="account_payment_group.view_account_payment_group_form"/>
        <field name="arch" type="xml">
            <field name="payment_date" position="after">
                <field name="is_datareader_op" invisible="1"/>
                <field name="datareader_op_date" string="Fecha de OP" attrs="{'invisible': [('is_datareader_op', '=', False)]}"/>
            </field>
        </field>
    </record>
</odoo>

