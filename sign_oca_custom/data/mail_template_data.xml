<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_sign_request" model="mail.template">
            <field name="name">Sign OCA: solicitud de firma</field>
            <field name="model_id" ref="sign_oca.model_sign_oca_request" />
            <field name="subject">New document to sign</field>
            <field name="auto_delete" eval="False" />
            <field name="lang">{{ object.create_uid.lang }}</field>
            <field name="body_html" type="html">
                <div>
                    <span>
                        <t t-out="object.create_uid.name" />
                        (<a
                            t-att-href="'mailto:%s?subject=%s' % (object.create_uid.email, 'Re: %s' % ctx.get('sign_subject', ''))"
                            style="color:#428BCA; text-decoration:none;"
                            target="_blank"
                        ><t t-out="object.create_uid.email" /></a>)
                        has requested your signature on a document.
                    </span>
                    <span t-if="ctx.get('sign_body')">
                        <div
                            style="margin: 16px 0px 16px 0px; padding: 8px 16px 8px 16px; background-color: #F1F1F1;"
                        >
                            <span>
                                <t t-out="ctx.get('sign_body')" />
                            </span>
                        </div>
                    </span>
                    <span>
                        <div style="margin:16px auto; text-align:center;">
                            <a
                                t-att-href="ctx.get('sign_link')"
                                style="padding: 8px 16px 8px 16px; border-radius: 3px; background-color:#875A7B; text-align:center; text-decoration:none; color: #FFFFFF;"
                            >
                                Sign document
                            </a>
                        </div>
                    </span>
                    <span>
                        <div style="opacity: 0.7;">
                            <strong>Warning</strong> do not forward this email to other people!<br />
                            They will be able to access this document and sign it as yourself.<br />
                        </div>
                    </span>
                </div>
            </field>
        </record>
    </data>
</odoo>
