<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="message_waiting_customer_reminder">
        <p style="margin: 0px;">
            <span>Hello <t t-out="object.user_id.name or ''"/>,</span><br/>
            <span style="margin-top: 8px;">
                The opportunity <strong><t t-out="object.name or ''"/></strong>
                is marked as <strong>"Waiting for Customer"</strong>.
            </span>
        </p>
        <p style="margin-top: 16px;">
            Customer: <t t-out="object.partner_id.name or 'Not set'"/><br/>
            Waiting since: <t t-out="object.waiting_customer_date or ''"/><br/>
            SLA Deadline: <t t-out="object.sla_deadline or ''"/>
        </p>
        <p>Please follow up to continue when appropriate.</p>
        <p style="padding-top: 24px; padding-bottom: 16px;">
            <a t-att-href="access_link" t-att-data-oe-model="object._name" t-att-data-oe-id="object.id"
               style="background-color:#875A7B; padding: 10px; text-decoration: none; color: #fff; border-radius: 5px;">
                View Opportunity
            </a>
        </p>
    </template>

</odoo>
