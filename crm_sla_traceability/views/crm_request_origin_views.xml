<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_request_origin_view_tree" model="ir.ui.view">
        <field name="name">crm.request.origin.tree</field>
        <field name="model">crm.request.origin</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="crm_request_origin_view_form" model="ir.ui.view">
        <field name="name">crm.request.origin.form</field>
        <field name="model">crm.request.origin</field>
        <field name="arch" type="xml">
            <form string="Traceability Origin">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_request_origin_view_search" model="ir.ui.view">
        <field name="name">crm.request.origin.search</field>
        <field name="model">crm.request.origin</field>
        <field name="arch" type="xml">
            <search string="Traceability Origins">
                <field name="name"/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="crm_request_origin_action" model="ir.actions.act_window">
        <field name="name">Traceability Origins</field>
        <field name="res_model">crm.request.origin</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
