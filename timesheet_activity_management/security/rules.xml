<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_management_report_company" model="ir.rule">
        <field name="name">Horas de gestión de compañías permitidas</field>
        <field name="model_id" ref="model_timesheet_management_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_timesheet_activity_viewer'))]"/>
    </record>
    <record id="rule_management_config_company" model="ir.rule">
        <field name="name">Configuración de gestión por compañía</field>
        <field name="model_id" ref="model_timesheet_management_report_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_timesheet_activity_admin'))]"/>
    </record>
    <record id="rule_management_weekly_run_company" model="ir.rule">
        <field name="name">Envíos de gestión por compañía</field>
        <field name="model_id" ref="model_timesheet_management_weekly_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_timesheet_activity_admin'))]"/>
    </record>
</odoo>
