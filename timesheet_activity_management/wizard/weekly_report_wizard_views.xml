<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_management_weekly_run_wizard" model="ir.ui.view">
        <field name="name">timesheet.management.weekly.run.wizard.form</field>
        <field name="model">timesheet.management.weekly.run.wizard</field>
        <field name="arch" type="xml">
            <form string="Regenerar reporte semanal">
                <group>
                    <field name="company_id"/>
                    <field name="week_start"/>
                </group>
                <footer>
                    <button name="action_send" type="object"
                            string="Generar y enviar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_management_weekly_run_wizard" model="ir.actions.act_window">
        <field name="name">Regenerar semana</field>
        <field name="res_model">timesheet.management.weekly.run.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_management_weekly_run_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
