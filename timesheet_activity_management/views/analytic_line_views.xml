<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_timesheet_sige_form_activity_management" model="ir.ui.view">
        <field name="name">timesheet.sige.form.activity.management</field>
        <field name="model">timesheet.sige</field>
        <field name="inherit_id" ref="timesheet_odoo.view_timessheet_sige_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='name']"
                   position="before">
                <field name="hour_type_in_management_report" invisible="1"/>
                <field name="activity_date" required="1"/>
                <field name="hour_type_id" required="1"
                       domain="[('active', '=', True)]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='name']"
                   position="attributes">
                <attribute name="attrs">{'required': ['|', ('project_no_facturable', '=', True), ('hour_type_in_management_report', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_task_form2_activity_management" model="ir.ui.view">
        <field name="name">project.task.form.activity.management</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='timesheet_ids']/tree/field[@name='name']"
                   position="before">
                <field name="activity_date" required="1"/>
                <field name="hour_type_id" required="1"
                       domain="[('active', '=', True)]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
    <record id="view_hr_timesheet_line_tree_activity_management" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.activity.management</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="activity_date" optional="show" required="1"/>
                <field name="hour_type_id" optional="show" required="1"
                       domain="[('active', '=', True)]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="hour_type_in_management_report" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="attrs">{'required': [('hour_type_in_management_report', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_hr_timesheet_line_form_activity_management" model="ir.ui.view">
        <field name="name">account.analytic.line.form.activity.management</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="activity_date" required="1"/>
                <field name="hour_type_id" required="1"
                       domain="[('active', '=', True)]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="hour_type_in_management_report" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="attrs">{'required': [('hour_type_in_management_report', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
