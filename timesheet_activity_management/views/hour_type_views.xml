<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hour_type_tree" model="ir.ui.view">
        <field name="name">timesheet.hour.type.tree</field>
        <field name="model">timesheet.hour.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="include_in_management_report"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_hour_type_form" model="ir.ui.view">
        <field name="name">timesheet.hour.type.form</field>
        <field name="model">timesheet.hour.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="include_in_management_report"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hour_types" model="ir.actions.act_window">
        <field name="name">Tipos de hora</field>
        <field name="res_model">timesheet.hour.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
