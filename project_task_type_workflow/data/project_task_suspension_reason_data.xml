    <record id="reason_espera_definicion" model="project.task.suspension.reason">
        <field name="name">Espera de definición funcional / cliente</field>
        <field name="sequence">10</field>
        <field name="is_other" eval="False"/>
    </record>

    <record id="reason_bloqueo_tecnico" model="project.task.suspension.reason">
        <field name="name">Bloqueo técnico / dependencias</field>
        <field name="sequence">20</field>
        <field name="is_other" eval="False"/>
