<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="next_invoice_or_close_subscription" model="ir.cron">
            <field name="name">Next Invoice or Close Subscription</field>
            <field name="model_id" ref="model_subscription_package"/>
            <field name="state">code</field>
            <field name="code">model.next_invoice_or_close()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>

        <record id="next_invoice_or_close_subscription_2min" model="ir.cron">
            <field name="name">Next Invoice or Close Subscription (Configurable)</field>
            <field name="model_id" ref="model_subscription_package"/>
            <field name="state">code</field>
            <field name="code">model.next_invoice_or_close()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>

</odoo>
