<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_form2_description_checklist" model="ir.ui.view">
        <field name="name">project.task.form.description.checklist</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="description" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <page name="description_page" position="after">
                <page name="acceptance_criteria" string="Criterio de aceptación">
                    <field name="acceptance_criteria_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="is_validated"/>
                        </tree>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>
