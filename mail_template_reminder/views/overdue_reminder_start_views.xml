<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="overdue_reminder_start_form_inherit" model="ir.ui.view">
            <field name="name">overdue.reminder.start.form.inherit</field>
            <field name="model">overdue.reminder.start</field>
            <field name="inherit_id" ref="account_invoice_overdue_reminder.overdue_reminder_start_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='options']" position="after">
                    <group name="template_info" string="Reminder Templates">
                        <div class="alert alert-info" role="alert">
                            <strong>Information:</strong> The first available reminder template 
                            for the selected company will be used. Make sure you have at least one 
                            template configured before continuing.
                        </div>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
