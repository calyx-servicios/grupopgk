<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_reminder_email" model="ir.ui.view">
        <field name="name">res.partner.form.reminder.email</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[2]" position="inside">
                <field name="reminder_email" widget="email"/>
            </xpath>
        </field>
    </record>
</odoo>
