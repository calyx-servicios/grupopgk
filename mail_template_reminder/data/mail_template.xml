<odoo noupdate="0">
    <record id="mail_template_reminder" model="mail.template">
        <field name="name">Overdue Invoice Reminder</field>
        <field name="is_reminder_template" eval="True"/>
        <field name="model_id" ref="account_invoice_overdue_reminder.model_overdue_reminder_step"/>
        <field name="auto_delete" eval="False"/>
        <field name="lang">{{object.partner_id.lang}}</field>
        <field name="email_from">{{object.user_id.email or object.company_id.email}}</field>
        <field name="email_to">{{object.partner_id.reminder_email or object.partner_id.email}}</field>
        <field name="subject">{{object.company_id.name}} - Overdue invoice reminder n°{{object.counter}}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px; font-size: 13px;">
                <p>Dear customer,</p>
                <p>According to our books, the following invoices are overdue:</p>

                <table style="border-spacing: 0; border-collapse: collapse; width: 100%; text-align: center;">
                    <tr>
                        <th style="padding: 5px; border: 1px solid black;">Invoice Number</th>
                        <th style="padding: 5px; border: 1px solid black;">Invoice Date</th>
                        <th style="padding: 5px; border: 1px solid black;">Payment Terms</th>
                        <th style="padding: 5px; border: 1px solid black;">Due Date</th>
                        <th style="padding: 5px; border: 1px solid black;">Type</th>
                        <th style="padding: 5px; border: 1px solid black;">Total Untaxed</th>
                        <th style="padding: 5px; border: 1px solid black;">Total</th>
                        <th style="padding: 5px; border: 1px solid black;">Residual</th>
                        <th style="padding: 5px; border: 1px solid black;">Past Reminders</th>
                    </tr>

                    <!-- Fila 1: Primera factura -->
                    <t t-if="object.get_invoice_safe(0).name and object.get_invoice_safe(0).name != 'INVISIBLE'">
                        <tr style="background-color: % if object.get_invoice_safe(0).move_type == 'out_refund': LightGray % endif;">
                            <td style="padding: 5px; border: 1px solid black;"><t t-out="object.get_invoice_safe(0).name"/></td>
                            <td style="padding: 5px; border: 1px solid black;"><t t-out="object.get_invoice_safe(0).invoice_date"/></td>
                            <td style="padding: 5px; border: 1px solid black;"><t t-out="object.get_invoice_safe(0).invoice_payment_term_id.name or ''"/></td>
                            <td style="padding: 5px; border: 1px solid black;"><t t-out="object.get_invoice_safe(0).invoice_date_due"/></td>
                            <td style="padding: 5px; border: 1px solid black;"><t t-out="object.get_invoice_safe(0).ref or ''"/></td>
                            <td style="padding: 5px; border: 1px solid black; text-align: right;"><t t-out="format_amount(object.get_invoice_safe(0).amount_untaxed * (object.get_invoice_safe(0).move_type == 'out_refund' and -1 or 1), object.get_invoice_safe(0).currency_id)"/></td>
                            <td style="padding: 5px; border: 1px solid black; text-align: right;"><t t-out="format_amount(object.get_invoice_safe(0).amount_total * (object.get_invoice_safe(0).move_type == 'out_refund' and -1 or 1), object.get_invoice_safe(0).currency_id)"/></td>
                            <td style="padding: 5px; border: 1px solid black; text-align: right;"><t t-out="format_amount(object.get_residual_by_index(0) * (object.get_invoice_safe(0).move_type == 'out_refund' and -1 or 1), object.get_invoice_safe(0).currency_id)"/></td>
                            <td style="padding: 5px; border: 1px solid black;"><t t-out="object.get_invoice_safe(0).overdue_reminder_counter"/></td>
                        </tr>
                    </t>

                    <!-- Fila 2: Segunda factura -->
