<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_analytic_line_account_update_view_form" model="ir.ui.view">
        <field name="name">account.analytic.line.account.update.form</field>
        <field name="model">account.analytic.line.account.update</field>
        <field name="arch" type="xml">
            <form string="Update Analytic Account">
                <group>
                    <field name="target_account_id_int" widget="integer_live"/>
                    <field name="target_account_id" nolabel="1" colspan="2" readonly="1"
                           options="{'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_analytic_line_account_update" model="ir.actions.act_window">
        <field name="name">Update Analytic Account</field>
        <field name="res_model">account.analytic.line.account.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="analytic.model_account_analytic_line"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('consolidation_report.group_update_analytic_account'))]"/>
    </record>
</odoo>
